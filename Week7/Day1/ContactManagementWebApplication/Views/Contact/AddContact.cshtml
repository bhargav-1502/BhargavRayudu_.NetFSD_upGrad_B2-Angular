@model Contact_Management_Web_Application.Models.ContactInfo

<h2>Add Contact</h2>

<form method="post">
    <label>Contact ID:</label>
    <input asp-for="ContactId" required /><br />

    <label>First Name:</label>
    <input asp-for="FirstName" required /><br />

    <label>Last Name:</label>
    <input asp-for="LastName" required /><br />

    <label>Company:</label>
    <input asp-for="CompanyName" /><br />

    <label>Email:</label>
    <input asp-for="EmailId" /><br />

    <label>Mobile:</label>
    <input asp-for="MobileNo" /><br />

    <label>Designation:</label>
    <input asp-for="Designation" /><br />

    <br />
    <button type="submit">Save</button>
</form>